# Example only: run python3 setup.py to create a private .env with random credentials.
# The IP must be the Linux server's LAN IPv4, reachable from the speaker.
LAN_IP=192.168.1.100
SONGLOFT_PORT=58091
FREE_MUSIC_PORT=58092
HOME_MUSIC_PUBLIC_URL=http://192.168.1.100:58092
SONGLOFT_IMAGE=songloft/songloft:2.13.8@sha256:2d404904dab32db885cff1c199cf0702b3e30b81c4ab32b7bea6cea36a076010
SONGLOFT_ADMIN_USERNAME=admin
SONGLOFT_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
HOME_MUSIC_TOKEN=REPLACE_WITH_RANDOM_TOKEN
HOME_MUSIC_UID=1000
HOME_MUSIC_GID=1000
HOME_MUSIC_MAX_LIBRARY_MB=5120
